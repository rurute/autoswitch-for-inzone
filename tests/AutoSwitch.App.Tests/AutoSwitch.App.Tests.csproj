<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>AutoSwitch.App.Tests</RootNamespace>
    <!-- 参照する AutoSwitch.App が WinForms を使うため、同じ土台に合わせる -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- xunit.v3 は Xunit 名前空間を自動 import しない -->
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AutoSwitch.App\AutoSwitch.App.csproj" />
  </ItemGroup>
</Project>
